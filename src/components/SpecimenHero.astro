---
/**
 * SpecimenHero.astro — signature element. A giant display word cycles through
 * every case transform, type-specimen style. Pure static HTML + one tiny inline
 * script (no framework island); respects prefers-reduced-motion.
 */
const WORD = 'oriz case'
const FRAMES = [
  'orizCase',
  'OrizCase',
  'oriz_case',
  'ORIZ_CASE',
  'oriz-case',
  'Oriz Case',
  'oriz.case',
]
---

<section class="hero" aria-label="Case & format converter">
  <div class="hero__grid">
    <p class="hero__kicker">Type specimen · case &amp; format converter</p>
    <h1 class="hero__display">
      <span class="hero__word" data-frames={JSON.stringify(FRAMES)}>orizCase</span>
    </h1>
    <p class="hero__lede">
      One box in, every case out — camelCase, snake_case, kebab-case,
      PascalCase, CONSTANT_CASE, Title, Sentence + identifier reformatting.
      <strong>100% in your browser.</strong>
    </p>
    <ul class="hero__marks" aria-hidden="true">
      <li>cC</li><li>Pc</li><li>s_</li><li>C_</li><li>k-</li><li>Tt</li><li>St</li>
    </ul>
  </div>
</section>

<script>
  const el = document.querySelector<HTMLElement>('.hero__word')
  if (el) {
    const frames: string[] = JSON.parse(el.dataset.frames ?? '[]')
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (!reduce && frames.length) {
      let i = 0
      setInterval(() => {
        i = (i + 1) % frames.length
        el.classList.add('is-swap')
        setTimeout(() => {
          el.textContent = frames[i]
          el.classList.remove('is-swap')
        }, 140)
      }, 1900)
    }
  }
</script>
