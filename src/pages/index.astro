---
import OzToolShell from '@chirag127/oz-chrome/components/OzToolShell.astro'
import SpecimenHero from '../components/SpecimenHero.astro'
import Converter from '../components/Converter.tsx'
import '../styles/theme.css'

const site = 'https://case.oriz.in'
const title = 'oriz-case — Free case converter: camelCase, snake_case, kebab-case · no signup'
const desc =
  'Free online case converter — turn text into camelCase, snake_case, kebab-case, PascalCase, CONSTANT_CASE, Title & Sentence. 100% in-browser, no upload, no signup.'
const ogImage = `${site}/favicon.svg`
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'oriz-case',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  url: `${site}/`,
  description: desc,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={`${site}/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <script src="/registerSW.js" is:inline></script>
  </head>
  <body>
    <OzToolShell site="case" title="Case &amp; format converter" wordmarkHref="https://oriz.in">
      <a slot="nav" href="https://github.com/chirag127/oriz-case" rel="noopener">source</a>
      <SpecimenHero />
      <Converter client:load />
      <a slot="footer" href="https://github.com/chirag127/oriz-case" rel="noopener">GitHub</a>
      <span slot="footer">100% client-side · no upload · no signup</span>
    </OzToolShell>
  </body>
</html>
